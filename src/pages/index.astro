---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DragCanvas from '../components/DragCanvas.astro';
import FloatingBuilding from '../components/FloatingBuilding.astro';

const buildings = (await getCollection('buildings')).sort((a, b) => a.data.number - b.data.number);
---

<Base fullBleed>
  <h1 class="sr-only">Buildings</h1>
  <DragCanvas>
    {
      buildings.map(({ id, data }, i) => (
        <div data-canvas-item>
          <FloatingBuilding
            href={`/buildings/${id}/`}
            name={data.name}
            image={data.cutout ?? data.photos[0].src}
            alt={data.photos[0].alt}
            delay={-i * 2.3}
          />
        </div>
      ))
    }
  </DragCanvas>
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
