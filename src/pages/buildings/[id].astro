---
// Shared template for every building. One page is generated per folder in src/content/buildings/.
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ModelViewer from '../../components/ModelViewer.astro';
import { formatNumber, formatSquareFeet, formatLot } from '../../lib/format';

export async function getStaticPaths() {
  const buildings = await getCollection('buildings');
  return buildings.map((building) => ({ params: { id: building.id }, props: { building } }));
}

interface Props {
  building: CollectionEntry<'buildings'>;
}

const { data } = Astro.props.building;

const facts: Array<[string, string]> = [
  ['Style', data.style],
  ['Location', data.location],
  ['Bedrooms', String(data.bedrooms)],
  ['Bathrooms', String(data.bathrooms)],
  ['Square footage', formatSquareFeet(data.squareFeet)!],
  ['Lot', formatLot(data.lotWidth, data.lotDepth)],
  ['Type', data.type],
];

// Floor plans are drawn as masks filled with the text color, so the linework matches the theme.
const plans = await Promise.all(
  data.floorPlans.map(async (plan) => ({
    ...plan,
    url: (await getImage({ src: plan.src, format: 'webp' })).src,
    width: Math.round(plan.src.width * plan.scale),
    height: Math.round(plan.src.height * plan.scale),
  })),
);
// At most two plans per row, so labels stay readable. The shared scale is set by the widest pair.
const PLANS_PER_ROW = 2;
const widest = [...plans].sort((a, b) => b.width - a.width);
const planRowTotal = widest.slice(0, PLANS_PER_ROW).reduce((sum, p) => sum + p.width, 0);
const planRowGaps = Math.min(plans.length, PLANS_PER_ROW) - 1;
const planMax = widest[0]?.width ?? 0;
---

<Base title={data.name} description={data.description}>
  <a href="/" class="back">← All buildings</a>

  <header class="head">
    <span class="num">{formatNumber(data.number)}</span>
    <h1>{data.name}</h1>
  </header>

  <div class="layout">
    <div class="primary">
      {
        data.model ? (
          <ModelViewer src={data.model.src} alt={data.model.alt} poster={(data.cutout ?? data.photos[0].src).src} />
        ) : (
          <Image src={data.photos[0].src} alt={data.photos[0].alt} widths={[800, 1400]} sizes="(min-width: 960px) 720px, 100vw" class="hero" />
        )
      }

      {
        plans.length > 0 && (
          <section
            class="plans"
            aria-label="Floor plans"
            style={`--total: ${planRowTotal}; --widest: ${planMax}; --gaps: ${planRowGaps}`}
          >
            {plans.map((plan) => (
              <figure style={`--w: ${plan.width}`}>
                <div
                  class="plan"
                  role="img"
                  aria-label={plan.alt}
                  style={`aspect-ratio: ${plan.width} / ${plan.height}; --plan: url("${plan.url}")`}
                />
                {plan.caption && <figcaption>{plan.caption}</figcaption>}
              </figure>
            ))}
          </section>
        )
      }
    </div>

    <aside class="details">
      <dl>
        {
          facts.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="note">Specs are estimates based on the floor plans.</p>
      <p class="description">{data.description}</p>
    </aside>
  </div>

</Base>

<style>
  .back {
    font-size: 0.9rem;
    text-decoration: none;
  }

  .head {
    margin: 1rem 0 1.5rem;
  }

  .num {
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .head h1 {
    margin: 0.2rem 0 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .layout {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
  }

  .hero {
    width: 100%;
    border-radius: var(--radius);
  }

  dl {
    margin: 0 0 1.25rem;
    display: grid;
    gap: 0.75rem;
  }

  dl div {
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.6rem;
  }

  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  dd {
    margin: 0.15rem 0 0;
    font-weight: 500;
  }

  .note {
    margin: -0.5rem 0 1.25rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .description {
    margin: 0;
  }

  /* All plans are drawn at one shared scale (--px = size of one image pixel), shrunk as needed
     to fit two per row, and never enlarged past the images' own resolution. */
  .plans {
    --gap: 2.5rem;
    container-type: inline-size;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: var(--gap);
    margin-top: 2.5rem;
  }

  .plans figure {
    /* Slightly under the exact fit so rounding never pushes the second plan onto a new row. */
    --px: min(1px, (100cqw - var(--gaps) * var(--gap) - 2px) / var(--total));
    flex: none;
    width: calc(var(--w) * var(--px));
    margin: 0;
  }

  /* Narrow screens: stack the plans, sized so the widest one fills the width. */
  @container (max-width: 560px) {
    .plans figure {
      --px: min(1px, 100cqw / var(--widest));
    }
  }

  .plan {
    width: 100%;
    background: var(--ink);
    -webkit-mask: var(--plan) center / contain no-repeat;
    mask: var(--plan) center / contain no-repeat;
  }

  figcaption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
