---
import Base from '../../layouts/Base.astro';
import { getArticles, readingTime, formatDate } from '../../lib/knowledge';

const articles = await getArticles();
---

<Base title="Knowledge" description="Essays on streets, zoning, and how to build better places.">
  <header class="intro">
    <h1>Knowledge</h1>
    <p>Essays on streets, zoning, and how to build better places, with sources.</p>
  </header>

  <ol class="list">
    {
      articles.map((article) => (
        <li>
          <a href={`/knowledge/${article.id}/`} class="item">
            <p class="meta">
              <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
              <span>{readingTime(article)}</span>
            </p>
            <div class="text">
              <h2>{article.data.title}</h2>
              <p class="dek">{article.data.description}</p>
              <span class="more">Read essay →</span>
            </div>
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .intro {
    margin: 1rem 0 2.5rem;
  }

  .intro h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0 0 0.5rem;
  }

  .intro p {
    margin: 0;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Frameless rows on the page background: date on the left, essay on the right. */
  .item {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 0.5rem 2.5rem;
    padding: 2rem 0;
    color: inherit;
    text-decoration: none;
  }

  .meta {
    display: grid;
    align-content: start;
    gap: 0.2rem;
    margin: 0.45rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .item h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    transition: color 0.2s;
  }

  .dek {
    margin: 0 0 0.9rem;
    max-width: 52rem;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .more {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
    display: inline-block;
    transition: transform 0.2s;
  }

  .item:hover h2,
  .item:focus-visible h2 {
    color: var(--accent);
  }

  .item:hover .more,
  .item:focus-visible .more {
    transform: translateX(4px);
  }

  @media (max-width: 720px) {
    .item {
      grid-template-columns: 1fr;
      padding: 1.5rem 0;
    }

    .meta {
      display: flex;
      gap: 0.75rem;
      margin: 0;
    }
  }
</style>
