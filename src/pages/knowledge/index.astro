---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getArticles, readingTime, formatDate } from '../../lib/knowledge';

const articles = await getArticles();
---

<Base title="Knowledge" description="Essays on streets, zoning, and how to build better places.">
  <header class="intro">
    <h1>Knowledge</h1>
    <p>Essays on streets, zoning, and how to build better places, with sources.</p>
  </header>

  <ol class="list">
    {
      articles.map((article) => (
        <li>
          <a href={`/knowledge/${article.id}/`} class="item">
            <Image src={article.data.cover} alt="" width={400} height={400} class="thumb" />
            <div class="text">
              <p class="meta">
                <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
                <span aria-hidden="true">·</span>
                <span>{readingTime(article)}</span>
              </p>
              <h2>{article.data.title}</h2>
              <p class="dek">{article.data.description}</p>
              <span class="more">Read essay →</span>
            </div>
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .intro {
    margin: 1rem 0 2.5rem;
  }

  .intro h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0 0 0.5rem;
  }

  .intro p {
    margin: 0;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Frameless rows on the page background: date on the left, essay on the right. */
  .item {
    display: grid;
    grid-template-columns: 11rem 1fr;
    align-items: center;
    gap: 0.5rem 2.25rem;
    padding: 2rem 0;
    color: inherit;
    text-decoration: none;
  }

  /* Thin rules between essays. */
  li + li .item {
    border-top: 1px solid var(--ink);
  }

  .thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 8px;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .item:hover .thumb,
  .item:focus-visible .thumb {
    transform: scale(1.03);
  }

  .meta {
    display: flex;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .item h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    transition: color 0.2s;
  }

  .dek {
    margin: 0 0 0.9rem;
    max-width: 52rem;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .more {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
    display: inline-block;
    transition: transform 0.2s;
  }

  .item:hover h2,
  .item:focus-visible h2 {
    color: var(--accent);
  }

  .item:hover .more,
  .item:focus-visible .more {
    transform: translateX(4px);
  }

  @media (max-width: 720px) {
    .item {
      grid-template-columns: 5.5rem 1fr;
      align-items: start;
      gap: 0.5rem 1rem;
      padding: 1.5rem 0;
    }

    .item h2 {
      font-size: 1.3rem;
    }

    .dek {
      font-size: 1rem;
    }
  }
</style>
