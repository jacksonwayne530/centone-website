---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../content/logo/logo.jpg';

interface Props {
  title?: string;
  description?: string;
  /** Page content fills the whole screen below the header (no footer, no page scroll). */
  fullBleed?: boolean;
}

const { title, description = 'A catalog of well-designed buildings.', fullBleed = false } = Astro.props;
const fullTitle = title ? `${title} · Centone` : 'Centone';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body class:list={{ 'full-bleed': fullBleed }}>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="wordmark">
          <Image src={logo} alt="" width={128} height={128} class="logo" loading="eager" />
          <span>Centone</span>
        </a>
        <span class="tagline">A catalog of well-designed buildings</span>
      </div>
    </header>
    <main>
      <slot />
    </main>
    {
      !fullBleed && (
        <footer class="site-footer">
          <p>© {new Date().getFullYear()} Centone</p>
        </footer>
      )
    }
  </body>
</html>
