---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'A catalog of well-designed buildings.' } = Astro.props;
const fullTitle = title ? `${title} · Centone` : 'Centone';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="wordmark">Centone</a>
      <span class="tagline">A catalog of well-designed buildings</span>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Centone</p>
    </footer>
  </body>
</html>
