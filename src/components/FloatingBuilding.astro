---
// An isometric building illustration that gently floats and magnifies on hover.
// Used on the homepage canvas; links to the building's detail page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  name: string;
  image: ImageMetadata;
  alt: string;
  /** Offsets the float animation so buildings don't bob in sync. */
  delay?: number;
}

const { href, name, image, alt, delay = 0 } = Astro.props;
---

<a href={href} class="building" style={`--delay: ${delay}s`} draggable="false">
  <div class="float">
    <Image
      src={image}
      alt={alt}
      widths={[480, 960, 1400]}
      sizes="(min-width: 720px) 460px, 90vw"
      loading="eager"
      draggable="false"
      class="art"
    />
  </div>
  <span class="label">{name}</span>
</a>

<style>
  .building {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--ink);
    outline: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  /* Vertical bob. */
  .float {
    width: 100%;
    animation: bob 9s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  /* Rendered at full size and scaled down at rest, so magnifying on hover stays sharp. */
  .art {
    width: 100%;
    height: auto;
    transform: scale(0.85);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    -webkit-user-drag: none;
  }

  .building:hover .art,
  .building:focus-visible .art {
    transform: scale(1);
  }

  .label {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }

  .building:hover .label,
  .building:focus-visible .label {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .label {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float {
      animation: none;
    }
  }
</style>
