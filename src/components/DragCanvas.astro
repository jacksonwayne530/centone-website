---
// A draggable canvas in the style of the Apple Watch app grid.
//
// - Items (children with [data-canvas-item]) are laid out in a hexagonal spiral from the center,
//   so the layout grows naturally as buildings are added.
// - Drag with mouse or touch; releases keep some momentum.
// - Scroll wheel / trackpad zooms around the cursor; on touch screens, pinch with two fingers.
// - Items shrink the farther they are from the middle of the screen (the fisheye effect).
// - Panning is bounded: past the edge it stretches like a rubber band, then springs back,
//   so a building can't be dragged completely off screen.
---

<div class="stage" data-canvas>
  <div class="world">
    <slot />
  </div>
</div>

<script>
  // Tuning
  const SPACING_X = 1.05; // horizontal gap between neighbors, as a multiple of item width
  const SPACING_Y = 0.78; // vertical gap between rows, as a multiple of item width
  const KEEP_VISIBLE = 0.32; // at the pan limit, the outermost item's center stays this far inside the screen (fraction of width/height)
  const FISHEYE_MIN = 0.55; // smallest scale an item shrinks to near the edges
  const FRICTION = 0.94; // momentum decay per frame after release
  const SPRING = 0.14; // how quickly an over-stretched canvas snaps back
  const DRAG_THRESHOLD = 6; // px of movement before a press counts as a drag (not a click)
  const MIN_ZOOM = 0.5;
  const MAX_ZOOM = 2.5;
  const WHEEL_ZOOM_SPEED = 0.0015; // per pixel of mouse-wheel scroll
  const PINCH_ZOOM_SPEED = 0.01; // per pixel of trackpad pinch (reported as ctrl + wheel)

  // Axial hex coordinates in spiral order: center, then ring 1 (starting to the right), ring 2...
  function hexSpiral(count: number): Array<[number, number]> {
    const dirs: Array<[number, number]> = [[1, 0], [1, -1], [0, -1], [-1, 0], [-1, 1], [0, 1]];
    const out: Array<[number, number]> = [[0, 0]];
    for (let k = 1; out.length < count; k++) {
      let q = dirs[0][0] * k;
      let r = dirs[0][1] * k;
      for (let side = 0; side < 6; side++) {
        const [dq, dr] = dirs[(side + 2) % 6];
        for (let step = 0; step < k; step++) {
          out.push([q, r]);
          q += dq;
          r += dr;
        }
      }
    }
    return out.slice(0, count);
  }

  // Resistance past the bounds: grows slower the farther you pull.
  function rubber(value: number, min: number, max: number, size: number): number {
    const band = (over: number) => (1 - 1 / ((over * 0.55) / size + 1)) * size;
    if (value < min) return min - band(min - value);
    if (value > max) return max + band(value - max);
    return value;
  }

  const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi);

  document.querySelectorAll<HTMLElement>('[data-canvas]').forEach((stage) => {
    const world = stage.querySelector<HTMLElement>('.world')!;
    const items = [...stage.querySelectorAll<HTMLElement>('[data-canvas-item]')];
    const images = [...stage.querySelectorAll<HTMLImageElement>('[data-canvas-item] img')];
    const coords = hexSpiral(items.length);
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Layout state (positions are in unzoomed world pixels)
    let vw = 0;
    let vh = 0;
    let phone = false;
    let itemW = 0;
    let positions: Array<{ x: number; y: number }> = [];
    let bounds = { minX: 0, maxX: 0, minY: 0, maxY: 0 }; // allowed pan range at the current zoom

    // View state. `raw` is where the finger says we are; the rendered pan is after rubber-banding.
    let zoom = 1;
    let raw = { x: 0, y: 0 };
    let vel = { x: 0, y: 0 };
    let dragging = false;
    let frame = 0;
    let sizedFor = 0; // largest on-screen image width requested so far (keeps zoomed images sharp)

    // Where the view is centered at the current zoom (the cluster, or building #1 on phones).
    function home() {
      if (phone) return { x: vw / 2, y: vh / 2 };
      const xs = positions.map((p) => p.x);
      const ys = positions.map((p) => p.y);
      return {
        x: vw / 2 - ((Math.min(...xs) + Math.max(...xs)) / 2) * zoom,
        y: vh / 2 - ((Math.min(...ys) + Math.max(...ys)) / 2) * zoom,
      };
    }

    // Pan limits keep at least the outermost item near the screen. If all items fit, the
    // range still allows a little play around the centered position.
    function computeBounds() {
      const xs = positions.map((p) => p.x * zoom);
      const ys = positions.map((p) => p.y * zoom);
      const keepX = vw * KEEP_VISIBLE;
      const keepY = vh * KEEP_VISIBLE;
      const c = home();
      // Zoomed out, the range narrows toward the centered view, so a shrunken cluster
      // settles back in the middle instead of wherever the cursor was.
      const settle = clamp((1 - zoom) / (1 - MIN_ZOOM), 0, 1);
      const toward = (v: number, target: number) => v + (target - v) * settle;
      bounds = {
        minX: toward(Math.min(keepX - Math.max(...xs), c.x), c.x),
        maxX: toward(Math.max(vw - keepX - Math.min(...xs), c.x), c.x),
        minY: toward(Math.min(keepY - Math.max(...ys), c.y), c.y),
        maxY: toward(Math.max(vh - keepY - Math.min(...ys), c.y), c.y),
      };
    }

    function layout() {
      const prevCenter = vw ? { x: raw.x - vw / 2, y: raw.y - vh / 2 } : null;
      vw = stage.clientWidth;
      vh = stage.clientHeight;
      phone = vw < 640;

      // Layout in units of one item width.
      const unit = coords.map(([q, r]) => ({ x: (q + r / 2) * SPACING_X, y: r * SPACING_Y }));
      const spanX = Math.max(...unit.map((p) => p.x)) - Math.min(...unit.map((p) => p.x)) + 1;
      const spanY = Math.max(...unit.map((p) => p.y)) - Math.min(...unit.map((p) => p.y));

      // Phones: one building fills most of the width and its neighbors peek in from the sides.
      // Larger screens: shrink buildings (down to a floor) so the whole cluster fits if it can.
      const preferred = phone ? vw * 0.62 : Math.min(vw * 0.36, vh * 0.6);
      const place = (w: number) =>
        items.forEach((el, i) => {
          el.style.width = `${w}px`;
          el.style.left = `${unit[i].x * w}px`;
          el.style.top = `${unit[i].y * w}px`;
        });
      place(preferred);
      const heightRatio = Math.max(...items.map((el) => el.offsetHeight)) / preferred || 1;
      const fitW = Math.min((vw * 0.94) / spanX, (vh * 0.94) / (spanY + heightRatio));
      itemW = clamp(phone ? preferred : Math.min(preferred, fitW), phone ? 160 : 240, 460);
      place(itemW);
      positions = unit.map((p) => ({ x: p.x * itemW, y: p.y * itemW }));

      computeBounds();
      raw = prevCenter
        ? { x: clamp(prevCenter.x + vw / 2, bounds.minX, bounds.maxX), y: clamp(prevCenter.y + vh / 2, bounds.minY, bounds.maxY) }
        : home();
      render();
    }

    function currentPan() {
      return {
        x: rubber(raw.x, bounds.minX, bounds.maxX, vw),
        y: rubber(raw.y, bounds.minY, bounds.maxY, vh),
      };
    }

    function render() {
      const pan = currentPan();
      world.style.transform = `translate3d(${pan.x}px, ${pan.y}px, 0) scale(${zoom})`;

      // Fisheye: scale each item by its distance from the middle of the screen.
      const radius = Math.hypot(vw, vh) / 2;
      items.forEach((el, i) => {
        const dx = pan.x + positions[i].x * zoom - vw / 2;
        const dy = pan.y + positions[i].y * zoom - vh / 2;
        const t = clamp(Math.hypot(dx, dy * 1.3) / radius, 0, 1);
        const scale = 1 - (1 - FISHEYE_MIN) * t * t;
        el.style.setProperty('--fisheye', scale.toFixed(3));
        el.style.opacity = (0.35 + 0.65 * scale ** 2).toFixed(3);
      });

      // When zoomed in, ask the browser for higher-resolution images so they stay sharp.
      const shown = Math.ceil(itemW * zoom);
      if (shown > sizedFor * 1.2) {
        sizedFor = shown;
        images.forEach((img) => (img.sizes = `${shown}px`));
      }
    }

    // Zoom so the world point under (sx, sy) (stage coordinates) stays put.
    function zoomAt(sx: number, sy: number, next: number, from = currentPan(), fromZoom = zoom) {
      const wx = (sx - from.x) / fromZoom;
      const wy = (sy - from.y) / fromZoom;
      zoom = clamp(next, MIN_ZOOM, MAX_ZOOM);
      computeBounds();
      raw = { x: sx - wx * zoom, y: sy - wy * zoom };
      render();
    }

    // Momentum + spring-back loop. Runs only while something is moving.
    function tick() {
      frame = 0;
      if (dragging) return;
      raw.x += vel.x;
      raw.y += vel.y;
      vel.x *= FRICTION;
      vel.y *= FRICTION;

      // Outside the bounds: kill momentum and spring back toward the edge.
      const tx = clamp(raw.x, bounds.minX, bounds.maxX);
      const ty = clamp(raw.y, bounds.minY, bounds.maxY);
      if (tx !== raw.x) {
        vel.x *= 0.5;
        raw.x += (tx - raw.x) * SPRING;
      }
      if (ty !== raw.y) {
        vel.y *= 0.5;
        raw.y += (ty - raw.y) * SPRING;
      }

      render();
      const moving = Math.abs(vel.x) > 0.05 || Math.abs(vel.y) > 0.05 || Math.abs(tx - raw.x) > 0.3 || Math.abs(ty - raw.y) > 0.3;
      if (moving) frame = requestAnimationFrame(tick);
      else {
        raw = { x: tx, y: ty };
        render();
      }
    }

    function startMotion() {
      if (!frame) frame = requestAnimationFrame(tick);
    }

    function toStage(e: { clientX: number; clientY: number }) {
      const r = stage.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }

    // Pointer input. One pointer drags; two pointers (touch) pinch-zoom and pan together.
    // Pointer capture starts only once a press becomes a drag, so ordinary clicks still reach
    // the building links.
    const pointers = new Map<number, { x: number; y: number }>();
    let press: { id: number; x: number; y: number; lastX: number; lastY: number; lastT: number } | null = null;
    let pinch: { dist: number; zoom: number; pan: { x: number; y: number }; mid: { x: number; y: number } } | null = null;
    let suppressClick = false;

    function beginDrag(id: number) {
      if (!dragging) {
        dragging = true;
        stage.classList.add('dragging');
      }
      suppressClick = true;
      stage.setPointerCapture(id);
    }

    function startPinch() {
      const [a, b] = [...pointers.values()];
      pinch = {
        dist: Math.max(Math.hypot(a.x - b.x, a.y - b.y), 1),
        zoom,
        pan: currentPan(),
        mid: { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 },
      };
      press = null;
      vel = { x: 0, y: 0 };
      pointers.forEach((_, id) => beginDrag(id));
    }

    stage.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      pointers.set(e.pointerId, toStage(e));
      // Grabbing a moving canvas stops it, and a stretched one stays where it's held.
      raw = { ...currentPan() };
      vel = { x: 0, y: 0 };
      if (pointers.size === 2) {
        startPinch();
      } else if (pointers.size === 1) {
        press = { id: e.pointerId, x: e.clientX, y: e.clientY, lastX: e.clientX, lastY: e.clientY, lastT: e.timeStamp };
        suppressClick = false;
      }
    });

    stage.addEventListener('pointermove', (e) => {
      if (!pointers.has(e.pointerId)) return;
      pointers.set(e.pointerId, toStage(e));

      if (pinch && pointers.size >= 2) {
        const [a, b] = [...pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        const mid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
        // Zoom around where the pinch started, then follow the fingers' midpoint.
        zoomAt(pinch.mid.x, pinch.mid.y, pinch.zoom * (dist / pinch.dist), pinch.pan, pinch.zoom);
        raw.x += mid.x - pinch.mid.x;
        raw.y += mid.y - pinch.mid.y;
        render();
        return;
      }

      if (!press || e.pointerId !== press.id) return;
      if (!dragging) {
        if (Math.hypot(e.clientX - press.x, e.clientY - press.y) < DRAG_THRESHOLD) return;
        beginDrag(e.pointerId);
      }
      const dx = e.clientX - press.lastX;
      const dy = e.clientY - press.lastY;
      const dt = Math.max(e.timeStamp - press.lastT, 1);
      raw.x += dx;
      raw.y += dy;
      // Velocity in px per frame (~16ms), smoothed.
      vel.x = vel.x * 0.6 + ((dx / dt) * 16) * 0.4;
      vel.y = vel.y * 0.6 + ((dy / dt) * 16) * 0.4;
      press.lastX = e.clientX;
      press.lastY = e.clientY;
      press.lastT = e.timeStamp;
      render();
    });

    function endPointer(e: PointerEvent) {
      if (!pointers.delete(e.pointerId)) return;

      if (pinch) {
        if (pointers.size >= 2) {
          startPinch();
          return;
        }
        pinch = null;
        // One finger still down: keep dragging with it, without a jump.
        const rest = [...pointers.entries()][0];
        if (rest) {
          const r = stage.getBoundingClientRect();
          const cx = rest[1].x + r.left;
          const cy = rest[1].y + r.top;
          raw = { ...currentPan() };
          press = { id: rest[0], x: cx, y: cy, lastX: cx, lastY: cy, lastT: e.timeStamp };
          return;
        }
        vel = { x: 0, y: 0 };
      } else if (press && e.pointerId === press.id) {
        // A pause before letting go means no fling.
        if (e.timeStamp - press.lastT > 80 || reduceMotion) vel = { x: 0, y: 0 };
      }

      press = null;
      if (pointers.size === 0 && dragging) {
        dragging = false;
        stage.classList.remove('dragging');
      }
      startMotion();
    }
    stage.addEventListener('pointerup', endPointer);
    stage.addEventListener('pointercancel', endPointer);

    // Don't follow a link at the end of a drag or pinch.
    stage.addEventListener(
      'click',
      (e) => {
        if (suppressClick) {
          e.preventDefault();
          e.stopPropagation();
          suppressClick = false;
        }
      },
      true,
    );

    // Mouse wheel and trackpad scrolling zoom around the cursor; trackpad pinches arrive as
    // ctrl + wheel and zoom too. If zooming pushes past the edges, the view springs back.
    stage.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        const lines = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? vh : 1;
        const speed = e.ctrlKey ? PINCH_ZOOM_SPEED : WHEEL_ZOOM_SPEED;
        const p = toStage(e);
        vel = { x: 0, y: 0 };
        zoomAt(p.x, p.y, zoom * Math.exp(-e.deltaY * lines * speed));
        startMotion();
      },
      { passive: false },
    );

    // Keyboard users: bring the focused building to the middle.
    // (Mouse clicks also focus links; moving the canvas then would swallow the click.)
    stage.addEventListener('focusin', (e) => {
      if (!(e.target as HTMLElement).matches(':focus-visible')) return;
      const i = items.findIndex((el) => el.contains(e.target as Node));
      if (i < 0) return;
      raw = {
        x: clamp(vw / 2 - positions[i].x * zoom, bounds.minX, bounds.maxX),
        y: clamp(vh / 2 - positions[i].y * zoom, bounds.minY, bounds.maxY),
      };
      vel = { x: 0, y: 0 };
      render();
    });

    new ResizeObserver(layout).observe(stage);
    layout();
    stage.classList.add('ready');
  });
</script>

<style>
  .stage {
    position: relative;
    flex: 1;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .stage.dragging {
    cursor: grabbing;
  }

  /* Hover magnification is distracting mid-drag. */
  .stage.dragging :global(a) {
    pointer-events: none;
  }

  .world {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    /* Hidden until the first layout so items don't flash in the corner. */
    visibility: hidden;
  }

  .stage.ready .world {
    visibility: visible;
  }

  .world > :global([data-canvas-item]) {
    position: absolute;
    transform: translate(-50%, -50%) scale(var(--fisheye, 1));
  }
</style>
