---
// Interactive 3D viewer for .glb / .gltf files, powered by Google's <model-viewer>.
// Drag to orbit, scroll or pinch to zoom, right-drag to pan. Sits directly on the page background.
interface Props {
  src: string;
  alt: string;
  poster?: string;
}

const { src, alt, poster } = Astro.props;
---

<div class="viewer">
  <model-viewer
    src={src}
    alt={alt}
    poster={poster}
    camera-controls
    bounds="tight"
    min-camera-orbit="auto 0deg auto"
    max-camera-orbit="auto 90deg auto"
    auto-rotate
    auto-rotate-delay="3000"
    interaction-prompt="auto"
    shadow-intensity="1"
    exposure="1"
    environment-image="neutral"
    loading="lazy"
    reveal="auto"
    touch-action="pan-y"
  >
    <div class="progress" slot="progress-bar"><div class="progress-fill"></div></div>
    <button class="fullscreen" type="button" aria-label="Toggle fullscreen">⛶</button>
  </model-viewer>
  <p class="hint">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12c0 2.2-4 4-9 4s-9-1.8-9-4 4-4 9-4c1.7 0 3.3.2 4.6.6" />
      <path d="M14.6 6.9l2 1.7-2.4 1" />
      <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
    </svg>
    Drag
  </p>
</div>

<script>
  import '@google/model-viewer';

  // On phones the viewer is short, so frame the building closer than model-viewer's default, which
  // leaves room for the whole bounding sphere and so wastes space above and below.
  const narrow = matchMedia('(max-width: 959px)');

  document.querySelectorAll<HTMLElement & { cameraOrbit: string }>('.viewer model-viewer').forEach((mv) => {
    const frame = () => (mv.cameraOrbit = narrow.matches ? 'auto auto 80%' : 'auto auto auto');
    frame();
    narrow.addEventListener('change', frame);

    const fill = mv.querySelector<HTMLElement>('.progress-fill');
    const bar = mv.querySelector<HTMLElement>('.progress');
    mv.addEventListener('progress', (e) => {
      const p = (e as CustomEvent<{ totalProgress: number }>).detail.totalProgress;
      if (fill) fill.style.width = `${p * 100}%`;
      if (bar) bar.hidden = p >= 1;
    });

    mv.querySelector('.fullscreen')?.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else mv.requestFullscreen();
    });
  });
</script>

<style>
  .viewer {
    margin: 0;
  }

  /* Phones: short, with the camera moved in (see script), so there's little empty space above
     and below the building. Larger screens: taller, so the building fills more of its column. */
  model-viewer {
    width: 100%;
    height: clamp(260px, 76vw, 400px);
    background: transparent;
    position: relative;
    --poster-color: transparent;
  }

  @media (min-width: 960px) {
    model-viewer {
      height: min(80vh, 720px);
    }
  }

  model-viewer:fullscreen {
    height: 100vh;
    background: var(--bg);
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: transparent;
  }

  .progress-fill {
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.2s;
  }

  .fullscreen {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 1.1rem;
    cursor: pointer;
  }

  .hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
    text-align: center;
  }
</style>
